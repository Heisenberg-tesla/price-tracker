# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Server Port
PORT=4000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Supabase (PostgreSQL) Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Reconciliation threshold for stale pending scrape logs (in milliseconds, default 10 minutes)
STALE_PENDING_MS=600000

# Scraper Settings
HEADLESS=true
STORE_BASE_URL=https://demo.inelabteamdev.com
CATALOG_CACHE_TTL_MS=600000
# Allowed CORS Origins (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173

# Cron Secret for /api/cron/scrape-due (Must be at least 16 characters, no default)
CRON_SECRET=
